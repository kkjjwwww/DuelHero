  keywords:
  - id: direction_select
    name: "\uBC29\uD5A5\uC9C0\uC815"
    description: "\uCE74\uB4DC \uC608\uC57D \uC2DC \uC2E4\uD589 \uBC29\uD5A5\uC744
      \uC120\uD0DD\uD55C\uB2E4."
    resolutionRule: "\uCE74\uB4DC \uC608\uC57D \uC2DC \uC120\uD0DD\uD55C \uBC29\uD5A5\uC744
      \uD589\uB3D9 \uD050\uC5D0 \uC800\uC7A5\uD55C\uB2E4. \uBC94\uC704 \uC88C\uD45C\uB294
      \uC804\uBC29 +Y\uB97C \uAE30\uC900\uC73C\uB85C \uC791\uC131\uD558\uACE0, \uC2E4\uD589
      \uC2DC \uC608\uC57D \uBC29\uD5A5\uC73C\uB85C \uD68C\uC804\uD558\uC5EC \uC801\uC6A9\uD55C\uB2E4.
      \uC608\uC57D \uC774\uD6C4 \uCE90\uB9AD\uD130 \uBC29\uD5A5\uC774 \uBC14\uB00C\uC5B4\uB3C4
      \uC608\uC57D \uBC29\uD5A5\uC744 \uC720\uC9C0\uD55C\uB2E4. \uC774 \uD0A4\uC6CC\uB4DC\uAC00
      \uC5C6\uB294 \uCE74\uB4DC\uB294 \uAE30\uBCF8\uC801\uC73C\uB85C \uBC29\uD5A5\uC774
      \uACE0\uC815\uB41C\uB2E4."
    triggerTiming: "\uC608\uC57D \uC2DC / \uD589\uB3D9 \uC2E4\uD589 \uC2DC"
    parameters: "\uC5C6\uC74C"
  - id: single_target
    name: "\uB2E8\uC77C\uB300\uC0C1"
    description: "\uBC94\uC704 \uB0B4 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uD55C
      \uBA85\uC744 \uB300\uC0C1\uC73C\uB85C \uD55C\uB2E4. \uAC19\uC740 \uAC70\uB9AC\uC758
      \uC801\uC774 \uC5EC\uB7EC \uBA85\uC774\uBA74 \uBB34\uC791\uC704\uB85C \uD55C
      \uBA85\uC744 \uC120\uD0DD\uD55C\uB2E4."
    resolutionRule: "\uD6A8\uACFC \uC2E4\uD589 \uC2DC \uBC94\uC704 \uB0B4 \uC801\uC744
      \uD6C4\uBCF4\uB85C \uC0BC\uACE0, \uD6A8\uACFC\uB97C \uC0AC\uC6A9\uD558\uB294
      \uCE90\uB9AD\uD130\uB85C\uBD80\uD130 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801
      \uD55C \uBA85\uC744 \uC120\uD0DD\uD55C\uB2E4. \uCD5C\uB2E8 \uAC70\uB9AC\uAC00
      \uAC19\uC740 \uC801\uC774 \uC5EC\uB7EC \uBA85\uC774\uBA74 \uADF8 \uD6C4\uBCF4\uB4E4
      \uC911 \uBB34\uC791\uC704\uB85C \uD55C \uBA85\uC744 \uC120\uD0DD\uD55C\uB2E4.
      \uBC94\uC704 \uB0B4 \uC801\uC774 \uC5C6\uC73C\uBA74 \uB300\uC0C1\uC774 \uC5C6\uB2E4.
      \uC774 \uD0A4\uC6CC\uB4DC\uAC00 \uC5C6\uB294 \uC801 \uB300\uC0C1 \uD6A8\uACFC\uB294
      \uBC94\uC704 \uB0B4 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uC801\uC6A9\uD55C\uB2E4."
    triggerTiming: "\uD589\uB3D9 \uC2E4\uD589 \uC2DC"
    parameters: 
