    textColor: '#FFBA47'
  - id: single_target
    name: "\uB2E8\uC77C\uB300\uC0C1"
    description: "\uBC94\uC704 \uB0B4 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uD55C
      \uBA85\uC744 \uB300\uC0C1\uC73C\uB85C \uD55C\uB2E4. \uAC19\uC740 \uAC70\uB9AC\uC758
      \uC801\uC774 \uC5EC\uB7EC \uBA85\uC774\uBA74 \uBB34\uC791\uC704\uB85C \uD55C
      \uBA85\uC744 \uC120\uD0DD\uD55C\uB2E4."
    parameters: 
    textColor: '#FFBA47'
  - id: stun
    name: "\uAE30\uC808"
    description: "\uAE30\uC808 \uC218\uCE58 \uB9CC\uD07C \uB2E4\uC74C \uD589\uB3D9\uC2AC\uB86F\uC744
      \uC0AC\uC6A9 \uD560 \uC218 \uC5C6\uB2E4. \uC774\uBBF8 \uC608\uC57D\uB41C \uD589\uB3D9\uC740
      \uCDE8\uC18C\uB41C\uB2E4."
    parameters: "\uAE30\uC808 \uC218\uCE58"
    textColor: '#FFBA47'
  - id: bleed
    name: "\uCD9C\uD608"
    description: "\uAC01 \uD589\uB3D9\uC2AC\uB86F \uC885\uB8CC \uC2DC \uCD9C\uD608
      \uC218\uCE58\uB9CC\uD07C \uBCF4\uD638\uB9C9\uC744 \uBB34\uC2DC\uD558\uB294
      \uD53C\uD574\uB97C \uBC1B\uACE0, \uCD9C\uD608 \uC218\uCE58\uAC00 1 \uAC10\uC18C\uD55C\uB2E4."
    parameters: "\uCD9C\uD608 \uC218\uCE58"
    textColor: '#FF5A5A'
  - id: counter
    name: "\uBC18\uACA9"
    description: "\uD574\uB2F9 \uD589\uB3D9\uC2AC\uB86F\uC5D0\uC11C \uC801\uC758
      \uC9C1\uC811 \uACF5\uACA9\uC744 \uBC1B\uC73C\uBA74, \uC591\uCE21\uC758 \uAE30\uBCF8
      \uD589\uB3D9\uC774 \uBAA8\uB450 \uB05D\uB09C \uB4A4 \uCE74\uB4DC\uC5D0 \uC9C0\uC815\uB41C
      \uD6A8\uACFC\uB97C 1\uD68C \uBC1C\uB3D9\uD55C\uB2E4."
    parameters: "\uC5C6\uC74C (\uD6A8\uACFC\uC640 \uBC94\uC704\uB294 \uCE74\uB4DC\uBCC4
      \uC815\uC758)"
    textColor: '#FFBA47'
  - id: preparation
    name: "\uC900\uBE44"
    description: "\uC804\uD22C \uC2DC\uC791 \uD6C4 \uC9C0\uC815\uB41C \uD134\uC774
      \uC9C0\uB098\uC57C \uC0AC\uC6A9\uD560 \uC218 \uC788\uB2E4."
    parameters: "\uC900\uBE44 \uD134 \uC218"
    textColor: '#999999'
  - id: exhaust
    name: "\uC18C\uBA78"
    description: "\uC0AC\uC6A9 \uD6C4 \uC774\uBC88 \uC804\uD22C \uB3D9\uC548 \uB2E4\uC2DC
      \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB2E4."
    parameters: 
    textColor: '#999999'
